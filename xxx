import os
import sys
import random
import math

if not os.environ.get("DISPLAY"):
    os.environ["DISPLAY"] = ":99"
if not os.environ.get("XDG_RUNTIME_DIR"):
    os.environ["XDG_RUNTIME_DIR"] = "/tmp/runtime-vscode"
    os.makedirs("/tmp/runtime-vscode", exist_ok=True)
os.environ["SDL_AUDIODRIVER"] = "dummy"

import pygame
pygame.init()

SCREEN_WIDTH  = 640
SCREEN_HEIGHT = 480
TITLE         = "Pygame"
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption(TITLE)

BLACK  = (  0,   0,   0)
WHITE  = (255, 255, 255)
RED    = (255,   0,   0)
BLUE   = (  0,   0, 255)
GREY   = (128, 128, 128)
GREEN = (0, 128, 0)
FONT = pygame.font.Font(None, 36)

clock = pygame.time.get_ticks() 
player1 = pygame.Rect(100,100,40,40)
player2 = pygame.Rect(100,100,40,40)
bullet1 = []
bullet2 = []
bulletpos1 = []
bulletpos2 = []
dmgtaken1 = 0
dmgtaken2 = 0
cooldown1 = 0
cooldown2 = 0

PLAYERSPEED = 5
BULLETSPEED = 15
DAMAGE = 20
HEALTH = 1000
COOLDOWN = 10

page = "menu"
running = True
#---
def bot_ai():
    global cooldown2

    # Distance between bot and player 1
    dx = player1.centerx - player2.centerx
    dy = player1.centery - player2.centery
    distance = math.hypot(dx, dy)

    # Move toward player 1
    if distance > 180:
        if dx > 0:
            player2.x += PLAYERSPEED
        elif dx < 0:
            player2.x -= PLAYERSPEED

        if dy > 0:
            player2.y += PLAYERSPEED
        elif dy < 0:
            player2.y -= PLAYERSPEED

    # If too close, move away
    elif distance < 120:
        if dx > 0:
            player2.x -= PLAYERSPEED
        elif dx < 0:
            player2.x += PLAYERSPEED

        if dy > 0:
            player2.y -= PLAYERSPEED
        elif dy < 0:
            player2.y += PLAYERSPEED

    # Keep bot inside the screen
    player2.clamp_ip(screen.get_rect())

    # Shoot at player 1
    if cooldown2 >= COOLDOWN:
        bulletpos2.append(
            pygame.Rect(player1.centerx, player1.centery, 4, 4)
        )

        bullet2.append(
            pygame.Rect(player2.centerx, player2.centery, 4, 4)
        )

        cooldown2 = 0

    for i in range(len(bullet2) - 1, -1, -1):
    dx = bulletpos2[i].centerx - bullet2[i].centerx
    dy = bulletpos2[i].centery - bullet2[i].centery

    dist = math.hypot(dx, dy)

    if dist != 0:
        bullet2[i].x += (dx / dist) * BULLETSPEED
        bullet2[i].y += (dy / dist) * BULLETSPEED

    if (
        bullet2[i].x < -10
        or bullet2[i].x > SCREEN_WIDTH + 10
        or bullet2[i].y < -10
        or bullet2[i].y > SCREEN_HEIGHT + 10
    ):
        bullet2.pop(i)
        bulletpos2.pop(i)
        continue

    if player1.colliderect(bullet2[i]):
        dmgtaken1 += DAMAGE
        bullet2.pop(i)
        bulletpos2.pop(i)
#---

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False
    screen.fill(BLACK)

    if page == "menu":
        menu_text = FONT.render("Press SPACE to start", True, WHITE)
        screen.blit(menu_text, (SCREEN_WIDTH // 2 - menu_text.get_width() // 2, SCREEN_HEIGHT // 2 - menu_text.get_height() // 2))
        if pygame.key.get_pressed()[pygame.K_SPACE]:
            page = "game"
    elif page == "game":
        cooldown1 += 1
        cooldown2 += 1
        if pygame.key.get_pressed()[pygame.K_w]:
            player1.y -= PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_a]:
            player1.x -= PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_s]:
            player1.y += PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_d]:
            player1.x += PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_i]:
            player2.y -= PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_j]:
            player2.x -= PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_k]:
            player2.y += PLAYERSPEED
        if pygame.key.get_pressed()[pygame.K_l]:
            player2.x += PLAYERSPEED
        player1.clamp_ip(screen.get_rect())
        player2.clamp_ip(screen.get_rect())

        if pygame.key.get_pressed()[pygame.K_LSHIFT] and cooldown1 >= COOLDOWN:
            bulletpos1.append(pygame.Rect(player2.x + 18,player2.y + 18,4,4))
            bullet1.append(pygame.Rect(player1.x + 18,player1.y + 18,4,4))
            cooldown1 = 0
        if pygame.key.get_pressed()[pygame.K_RSHIFT] and cooldown2 >= COOLDOWN:
            bulletpos2.append(pygame.Rect(player1.x + 18,player1.y + 18,4,4))
            bullet2.append(pygame.Rect(player2.x + 18,player2.y + 18,4,4))
            cooldown2 = 0

        for i in range(len(bullet1)):
            dx = bulletpos1[i].centerx - bullet1[i].centerx
            dy = bulletpos1[i].centery - bullet1[i].centery
            dist = math.hypot(dx, dy)
            if dist != 0:
                bullet1[i].x += (dx / dist) * SPEED
                bullet1[i].y += (dy / dist) * SPEED
            if bullet1[i].x < -10 or bullet1[i].x > SCREEN_WIDTH + 10 or bullet1[i].y < -10 or bullet1[i].y > SCREEN_HEIGHT + 10:
                bullet1.pop(i)
                bulletpos1.pop(i)
            if player2.colliderect(bullet1[i]):
                dmgtaken2 += DAMAGE
                bulletpos1.pop(i)
                bullet1.pop(i)
        for i in range(len(bullet2)):
            dx = bulletpos2[i].centerx - bullet2[i].centerx
            dy = bulletpos2[i].centery - bullet2[i].centery
            dist = math.hypot(dx, dy)
            if dist != 0:
                bullet2[i].x += (dx / dist) * BULLETSPEED
                bullet2[i].y += (dy / dist) * BULLETSPEED
            if bullet2[i].x < -10 or bullet2[i].x > SCREEN_WIDTH + 10 or bullet2[i].y < -10 or bullet2[i].y > SCREEN_HEIGHT + 10:
                bullet2.pop(i)
                bulletpos2.pop(i)
            if player1.colliderect(bullet2[i]):
                dmgtaken1 += DAMAGE
                bulletpos2.pop(i)
                bullet2.pop(i)

        if dmgtaken1 >= HEALTH:
            page = "gameover"
        elif dmgtaken2 >= HEALTH:
            page = "gameover"

        pygame.draw.rect(screen, BLUE, player1)
        pygame.draw.rect(screen, RED, player2)
        for a in bullet1:
            pygame.draw.rect(screen, BLUE, a)
        for a in bullet2:
            pygame.draw.rect(screen, RED, a)

        health1_text = FONT.render(f"Player 1 Health: {HEALTH - dmgtaken1}", True, WHITE)
        screen.blit(health1_text, (0, 10))
        health2_text = FONT.render(f"Player Health: {HEALTH - dmgtaken2}", True, WHITE)
        screen.blit(health2_text, (SCREEN_WIDTH - health2_text.get_width(), 10))
    elif page == "gameover":
        if dmgtaken1 >= HEALTH:
            gameover_text = FONT.render("Player 2 Wins!", True, WHITE)
        elif dmgtaken2 >= HEALTH:
            gameover_text = FONT.render("Player 1 Wins!", True, WHITE)
        else:
            gameover_text = FONT.render("Game Over, DRAW.", True, WHITE)
        menu_text = FONT.render("Press SPACE to restart", True, WHITE)
        screen.blit(gameover_text, (SCREEN_WIDTH // 2 - gameover_text.get_width() // 2, (SCREEN_HEIGHT // 2 - gameover_text.get_height() // 2) - 40))
        screen.blit(menu_text, (SCREEN_WIDTH // 2 - menu_text.get_width() // 2, (SCREEN_HEIGHT // 2 + menu_text.get_height()) + 40))
        
        clock = pygame.time.get_ticks() 
        player1 = pygame.Rect(100,100,40,40)
        player2 = pygame.Rect(100,100,40,40)
        bullet1 = []
        bullet2 = []
        bulletpos1 = []
        bulletpos2 = []
        dmgtaken1 = 0
        dmgtaken2 = 0
        cooldown1 = 0
        cooldown2 = 0
        if pygame.key.get_pressed()[pygame.K_SPACE]:
            page = "game"
    elif page == "tutorial":
        pass  
    pygame.display.flip() 
    pygame.time.Clock().tick(60)    

pygame.quit()
sys.exit()
